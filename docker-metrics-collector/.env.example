# GitHub Container Registry settings
GITHUB_USER=your-github-username
VERSION=latest

# Agent settings
PORT=5000
HOSTNAME=

# Docker group ID (find with: getent group docker | cut -d: -f3)
DOCKER_GID=999

# Optional appsettings.json overrides.
# ASP.NET Core binds environment variables over appsettings.json using "__"
# as the section separator, so these need no code changes. Both are left empty
# in appsettings.json on purpose - never commit a real host or password.
# DockerApi__BaseUrl=http://docker-host:2375
# Postgres__ConnectionString=Host=db-host;Database=docker_metrics;Username=docker_metrics;Password=change-me
